{
  "name": "broadside",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @broadside/app dev",
    "build": "pnpm --filter @broadside/app build",
    "preview": "pnpm --filter @broadside/app preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "depcheck": "depcruise packages --config dependency-cruiser.config.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "vitest run -c vitest.audit.config.ts",
    "test:e2e": "playwright test",
    "gen": "node tools/gen/run.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm depcheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5"
  }
}
